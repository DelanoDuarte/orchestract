# ---------------------------------------------------------------------------
# Orchestract environment. Copy to `.env` and fill in the values:
#     cp .env.example .env
#
# App settings are read with the ORCHESTRACT_ prefix (see app/config.py).
# The AI features read ANTHROPIC_API_KEY (unprefixed).
# ---------------------------------------------------------------------------

# --- PostgreSQL ---------------------------------------------------------------
# Used by the `db` service and to compose ORCHESTRACT_DATABASE_URL in compose.
POSTGRES_USER=orchestract
POSTGRES_DB=orchestract
# REQUIRED. Use a long random value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Web / process ------------------------------------------------------------
# Number of uvicorn worker processes.
WEB_CONCURRENCY=2
# Host port for local/direct runs (docker-compose.override.yml only).
WEB_PORT=8000

# --- Security / URLs ----------------------------------------------------------
# REQUIRED. Encrypts stored storage credentials & OAuth tokens. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes previously stored secrets undecryptable.
ORCHESTRACT_STORAGE_ENCRYPTION_KEY=

# Send the session cookie only over HTTPS. Leave this UNSET here: the compose
# files already set it correctly (true in production, false for the local
# http overlay). Only set it explicitly if you run the app outside compose —
# and keep it `false` for plain `uv run` dev over http://127.0.0.1.
# ORCHESTRACT_SESSION_COOKIE_SECURE=true

# Public URLs — used in emails and OAuth redirects. In production set these to
# your https://your-domain. Locally they default to http://localhost:8000.
ORCHESTRACT_APP_BASE_URL=https://your-domain.example
ORCHESTRACT_OAUTH_REDIRECT_BASE=https://your-domain.example

# --- Caddy (production TLS; docker-compose.prod.yml) --------------------------
DOMAIN=your-domain.example
ACME_EMAIL=admin@your-domain.example

# --- AI (Anthropic) — optional; AI features disabled when empty ---------------
ANTHROPIC_API_KEY=

# --- Transactional email (Resend) — optional; logs instead when empty ---------
ORCHESTRACT_RESEND_API_KEY=
ORCHESTRACT_EMAIL_FROM_ADDRESS=Orchestract <onboarding@resend.dev>

# --- Billing (Stripe) — optional; billing shows "not configured" when empty ---
ORCHESTRACT_STRIPE_SECRET_KEY=
ORCHESTRACT_STRIPE_WEBHOOK_SECRET=
ORCHESTRACT_STRIPE_PRICE_TEAM=
ORCHESTRACT_STRIPE_PRICE_BUSINESS=

# --- Drive import OAuth (Google Drive / OneDrive) — optional ------------------
ORCHESTRACT_GOOGLE_OAUTH_CLIENT_ID=
ORCHESTRACT_GOOGLE_OAUTH_CLIENT_SECRET=
ORCHESTRACT_MICROSOFT_OAUTH_CLIENT_ID=
ORCHESTRACT_MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Migrations ---------------------------------------------------------------
# Set to 0 to skip `alembic upgrade head` on container start (e.g. when you run
# migrations as a separate step across multiple web replicas).
RUN_MIGRATIONS=1
