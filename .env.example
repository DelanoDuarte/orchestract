# ---------------------------------------------------------------------------
# Orchestract environment. Copy to `.env` and fill in the values:
#     cp .env.example .env
#
# App settings are read with the ORCHESTRACT_ prefix (see app/config.py).
# The AI features read Google Gemini (summaries) and ANTHROPIC (assistant)
# credentials from unprefixed env vars.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---------------------------------------------------------------
# Used by the `db` service and to compose ORCHESTRACT_DATABASE_URL in compose.
POSTGRES_USER=orchestract
POSTGRES_DB=orchestract
# REQUIRED. Use a long random value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Database URL (SQLAlchemy async). Docker Compose sets this automatically to the
# Postgres `db` service, so you normally leave it blank here. It only matters
# for NON-Compose deployments (bare uvicorn): set it to your Postgres DSN.
# SQLite is dev-only — with ORCHESTRACT_APP_ENV=production the app refuses to
# start on SQLite. Uncomment and edit for a non-Compose Postgres:
# ORCHESTRACT_DATABASE_URL=postgresql+asyncpg://orchestract:change-me@your-db-host:5432/orchestract

# "development" (default) or "production". Compose's prod overlay sets this to
# production; set it yourself for any non-Compose production deployment.
# ORCHESTRACT_APP_ENV=production

# --- Web / process ------------------------------------------------------------
# Number of uvicorn worker processes.
WEB_CONCURRENCY=2
# Host port for local/direct runs (docker-compose.override.yml only).
WEB_PORT=8000

# --- Security / URLs ----------------------------------------------------------
# REQUIRED. Encrypts stored storage credentials & OAuth tokens. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes previously stored secrets undecryptable.
ORCHESTRACT_STORAGE_ENCRYPTION_KEY=

# Send the session cookie only over HTTPS. Leave this UNSET here: the compose
# files already set it correctly (true in production, false for the local
# http overlay). Only set it explicitly if you run the app outside compose —
# and keep it `false` for plain `uv run` dev over http://127.0.0.1.
# ORCHESTRACT_SESSION_COOKIE_SECURE=true

# Public URLs — used in emails and OAuth redirects. In production set these to
# your https://your-domain. Locally they default to http://localhost:8000.
ORCHESTRACT_APP_BASE_URL=https://your-domain.example
ORCHESTRACT_OAUTH_REDIRECT_BASE=https://your-domain.example

# --- Caddy (production TLS; docker-compose.prod.yml) --------------------------
DOMAIN=your-domain.example
ACME_EMAIL=admin@your-domain.example

# --- AI: document summaries (Google Gemini) — optional ------------------------
# Summarization runs on Gemini. Pick ONE of two backends:
#
# Option 1 — Gemini Developer API (simplest; recommended for non-GCP hosts like
# Railway). Just a single API key, no service account, no ADC. Create it at
# https://aistudio.google.com inside a project that has BILLING ENABLED so you're
# on the paid tier (the free tier may use your content to improve products — not
# appropriate for contract text). Set GOOGLE_API_KEY and leave the Vertex vars
# below blank. (GEMINI_API_KEY is accepted as an alias.)
GOOGLE_API_KEY=
#
# Option 2 — Vertex AI via Application Default Credentials (ADC). Enable by
# opting into Vertex and naming your GCP project + region; auth resolves from ADC
# at call time. The identity needs the "Vertex AI User" role.
#   Local dev:  `gcloud auth application-default login` provides ADC.
#   GCP-hosted: use an attached service account / Workload Identity (keyless).
# Summaries stay disabled until GOOGLE_GENAI_USE_VERTEXAI=true and
# GOOGLE_CLOUD_PROJECT are both set. If GOOGLE_API_KEY above is set, that wins
# unless GOOGLE_GENAI_USE_VERTEXAI=true.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Path to the ADC service-account JSON. For Docker, mount the file into the web
# container and set this to the in-container path, e.g.:
#   volumes: [ "./gcp-sa.json:/secrets/gcp-sa.json:ro" ]
#   GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
# Leave blank when ADC comes from `gcloud auth application-default login` or a
# GCP-attached service account.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: override the summarization model (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# --- AI: contract assistant (Anthropic) — optional; disabled when empty -------
# The autonomous workflow assistant still runs on Claude. Leave empty to keep
# it off; summaries above work independently.
ANTHROPIC_API_KEY=

# --- Transactional email (Resend) — optional; logs instead when empty ---------
ORCHESTRACT_RESEND_API_KEY=
ORCHESTRACT_EMAIL_FROM_ADDRESS=Orchestract <onboarding@resend.dev>

# --- Billing (Stripe) — optional; billing shows "not configured" when empty ---
# Use test keys for dev. Prefer a restricted key (rk_...) over a full secret key.
# 1) Set the secret key, then create the products/prices (idempotent):
#      uv run python -m app.infrastructure.billing.setup_stripe   (or: make stripe-setup)
#    Paste the printed price ids into PRICE_TEAM / PRICE_BUSINESS below.
# 2) For local webhooks, run the Stripe CLI and copy its whsec_... here:
#      stripe listen --forward-to localhost:8000/webhooks/stripe
#    In production, add a Dashboard webhook endpoint for events:
#      checkout.session.completed, customer.subscription.created/updated/deleted
ORCHESTRACT_STRIPE_SECRET_KEY=
ORCHESTRACT_STRIPE_PUBLISHABLE_KEY=
ORCHESTRACT_STRIPE_WEBHOOK_SECRET=
ORCHESTRACT_STRIPE_PRICE_TEAM=
ORCHESTRACT_STRIPE_PRICE_BUSINESS=

# --- Google/Microsoft OAuth — optional ----------------------------------------
# The Google client below powers BOTH "Continue with Google" login AND Google
# Drive import. In the Google Cloud console, add these Authorized redirect URIs
# to the same OAuth client (swap the host for production via OAUTH_REDIRECT_BASE):
#   {OAUTH_REDIRECT_BASE}/auth/google/callback         (social login)
#   {OAUTH_REDIRECT_BASE}/oauth/google-drive/callback  (Drive import)
# and ensure the OAuth consent screen includes the openid / email / profile
# scopes. The "Continue with Google" button stays hidden until both the client
# id and secret are set.
ORCHESTRACT_GOOGLE_OAUTH_CLIENT_ID=
ORCHESTRACT_GOOGLE_OAUTH_CLIENT_SECRET=
ORCHESTRACT_MICROSOFT_OAUTH_CLIENT_ID=
ORCHESTRACT_MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Migrations ---------------------------------------------------------------
# Set to 0 to skip `alembic upgrade head` on container start (e.g. when you run
# migrations as a separate step across multiple web replicas).
RUN_MIGRATIONS=1
